# JWT secrets
jwt.secret=${JWT_SECRET:change-me-256bit-random-secret-for-dev-only-do-not-use-in-prod}
jwt.access-ttl-minutes=15
jwt.refresh-ttl-days=14
jwt.cookie-name=__Secure-refresh
jwt.cookie-secure=false
jwt.cookie-same-site=Lax
jwt.cookie-path=/auth
