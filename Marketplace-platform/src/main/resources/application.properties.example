# application.properties.example
# Copy this file to src/main/resources/application.properties and fill in real values
# or set the values via environment variables (recommended).

# Cloudinary
cloudinary.cloud-name=YOUR_CLOUDINARY_CLOUD_NAME
cloudinary.api-key=YOUR_CLOUDINARY_API_KEY
cloudinary.api-secret=YOUR_CLOUDINARY_API_SECRET

# Datasource (replace <DB_HOST>, <DB_PORT>, <DB_NAME> or use env vars)
spring.datasource.url=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
# It's recommended to supply username/password via environment variables instead of committing them
spring.datasource.username=${DB_USERNAME:avnadmin}
spring.datasource.password=${DB_PASSWORD:change_me}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Optional duplicate keys used by the app (placeholders)
mysql.host=<DB_HOST>
mysql.port=<DB_PORT>
mysql.database=<DB_NAME>
mysql.username=${DB_USERNAME:avnadmin}
mysql.password=${DB_PASSWORD:change_me}

# Application port
server.port=8000
